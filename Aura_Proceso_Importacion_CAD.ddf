End Function

Function ElegirCapaDestinoExterno(ByVal extCadDoc As Deswik.Graphics.Application,
                                  ByVal extCadConteo As Integer,
                                  ByRef extCadVaciarSalida As Boolean,
                                  ByRef extCadAplicarColorSalida As Boolean,
                                  ByRef extCadRojoSalida As Integer,
                                  ByRef extCadVerdeSalida As Integer,
                                  ByRef extCadAzulSalida As Integer) As String
    Dim extCadHelper As String = CrearHelperTemporalImportacionAura()

    Dim extCadToken As String = Guid.NewGuid().ToString("N")
    Dim extCadEntrada As String = Path.Combine(Path.GetTempPath(),
                                               "deswik_cad_input_" &amp; extCadToken &amp; ".txt")
    Dim extCadSalida As String = Path.Combine(Path.GetTempPath(),
                                              "deswik_cad_output_" &amp; extCadToken &amp; ".txt")
    Dim extCadTexto As New System.Text.StringBuilder()
    extCadTexto.AppendLine(extCadConteo.ToString())

    Dim extCadNombresCapas As New List(Of String)()
    For Each extCadLayer As Deswik.Graphics.Primaries.Layer In extCadDoc.Layers
        If EsLayerDestinoSeleccionable(extCadLayer) Then
            extCadNombresCapas.Add(extCadLayer.Name)
        End If
    Next

    Dim extCadActiva As String = "IMPORTACION_CAD"
    If EsLayerDestinoSeleccionable(extCadDoc.ActiveLayer) Then
        extCadActiva = extCadDoc.ActiveLayer.Name
    ElseIf extCadNombresCapas.Count &gt; 0 Then
        extCadActiva = extCadNombresCapas(0)
    End If
    extCadTexto.AppendLine(extCadActiva)
    For Each extCadNombreCapa As String In extCadNombresCapas
        extCadTexto.AppendLine(extCadNombreCapa)
    Next
    File.WriteAllText(extCadEntrada, extCadTexto.ToString(), System.Text.Encoding.UTF8)

    Try
        Dim extCadInicio As New System.Diagnostics.ProcessStartInfo()
        extCadInicio.FileName = "powershell.exe"
        extCadInicio.Arguments = "-NoProfile -ExecutionPolicy Bypass -STA -File """ &amp;
                                 extCadHelper &amp; """ -InputPath """ &amp;
                                 extCadEntrada &amp; """ -OutputPath """ &amp;
                                 extCadSalida &amp; """"
        extCadInicio.UseShellExecute = False
        extCadInicio.CreateNoWindow = True

        Dim extCadProceso As System.Diagnostics.Process =
            System.Diagnostics.Process.Start(extCadInicio)
        If extCadProceso Is Nothing Then Throw New Exception("No se pudo iniciar el formulario auxiliar.")
        extCadProceso.WaitForExit()

        If extCadProceso.ExitCode &lt;&gt; 0 OrElse Not File.Exists(extCadSalida) Then
            Throw New Exception("El formulario auxiliar termino sin devolver una seleccion.")
        End If

        Dim extCadLineas() As String = File.ReadAllLines(extCadSalida)
        If extCadLineas.Length = 0 OrElse extCadLineas(0) &lt;&gt; "OK" Then Return ""
        If extCadLineas.Length &lt; 7 Then Throw New Exception("La respuesta del formulario esta incompleta.")

        extCadVaciarSalida = (extCadLineas(2) = "1")
        extCadAplicarColorSalida = (extCadLineas(3) = "1")
        extCadRojoSalida = Integer.Parse(extCadLineas(4))
        extCadVerdeSalida = Integer.Parse(extCadLineas(5))
        extCadAzulSalida = Integer.Parse(extCadLineas(6))
        If extCadRojoSalida &lt; 0 OrElse extCadRojoSalida &gt; 255 OrElse
           extCadVerdeSalida &lt; 0 OrElse extCadVerdeSalida &gt; 255 OrElse
           extCadAzulSalida &lt; 0 OrElse extCadAzulSalida &gt; 255 Then
            Throw New Exception("Los valores RGB deben estar entre 0 y 255.")
        End If
        Return extCadLineas(1).Trim()
    Catch extCadEx As Exception
        MessageBox.Show("No se pudo obtener la configuracion: " &amp; extCadEx.Message,
                        "Importacion DXF/DWG",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Error)
        Return ""
    Finally
        Try
            If File.Exists(extCadEntrada) Then File.Delete(extCadEntrada)
            If File.Exists(extCadSalida) Then File.Delete(extCadSalida)
            If File.Exists(extCadHelper) Then File.Delete(extCadHelper)
        Catch
        End Try
    End Try
End Function

Sub EstablecerOpcionCombinacion(ByVal raiz As Control,
                                ByVal nombreControl As String,
                                ByVal valor As Boolean)
    If String.Equals(raiz.Name, nombreControl, StringComparison.OrdinalIgnoreCase) Then
        Dim propiedadChecked As PropertyInfo =
            raiz.GetType().GetProperty("Checked",
                                       BindingFlags.Public Or BindingFlags.Instance)
        If propiedadChecked IsNot Nothing AndAlso propiedadChecked.CanWrite Then
            propiedadChecked.SetValue(raiz, valor, Nothing)
        End If
    End If

    For Each controlHijo As Control In raiz.Controls
        EstablecerOpcionCombinacion(controlHijo, nombreControl, valor)
    Next
End Sub

Function BuscarControlPorNombre(ByVal raiz As Control,
                                ByVal nombreControl As String) As Control
    If String.Equals(raiz.Name, nombreControl, StringComparison.OrdinalIgnoreCase) Then
        Return raiz
    End If

    For Each controlHijo As Control In raiz.Controls
        Dim encontrado As Control = BuscarControlPorNombre(controlHijo, nombreControl)
        If encontrado IsNot Nothing Then Return encontrado
    Next

    Return Nothing
End Function

Function BuscarControlPorTexto(ByVal raiz As Control,
                               ByVal textoControl As String) As Control
    If String.Equals(raiz.Text, textoControl, StringComparison.OrdinalIgnoreCase) Then
        Return raiz
    End If

    For Each controlHijo As Control In raiz.Controls
        Dim encontrado As Control = BuscarControlPorTexto(controlHijo, textoControl)
        If encontrado IsNot Nothing Then Return encontrado
    Next

    Return Nothing
End Function

Sub EjecutarClickControl(ByVal controlObjetivo As Control)
    If controlObjetivo Is Nothing Then Exit Sub

    Dim metodoClick As MethodInfo = controlObjetivo.GetType().GetMethod(
        "PerformClick", BindingFlags.Public Or BindingFlags.Instance)
    If metodoClick IsNot Nothing Then metodoClick.Invoke(controlObjetivo, Nothing)
End Sub

Sub ResolverAvisoCombinacionDXF(ByVal sender As Object, ByVal e As EventArgs)
    Try
        For indice As Integer = System.Windows.Forms.Application.OpenForms.Count - 1 To 0 Step -1
            Dim formulario As Form = System.Windows.Forms.Application.OpenForms(indice)
            If formulario Is Nothing Then Continue For

            Dim esSelectorCapas As Boolean =
                String.Equals(formulario.GetType().Name,
                              "fLayerSelection",
                              StringComparison.OrdinalIgnoreCase) OrElse
                formulario.Text.IndexOf("Layer Selection",
                                        StringComparison.OrdinalIgnoreCase) &gt;= 0

            If esSelectorCapas Then
                ' Deswik 2025.2 puede ignorar PromptForLayers=False para DXF/DWG.
                ' Se oculta el cuadro y se confirma la seleccion completa sin intervencion.
                formulario.Opacity = 0

                Dim botonTodas As Control = BuscarControlPorTexto(formulario, "Select all")
                If botonTodas Is Nothing Then
                    botonTodas = BuscarControlPorNombre(formulario, "bSelectAll")
                End If
                EjecutarClickControl(botonTodas)

                Dim botonAceptarCapas As Control = BuscarControlPorTexto(formulario, "OK")
                If botonAceptarCapas Is Nothing Then
                    botonAceptarCapas = BuscarControlPorNombre(formulario, "bOK")
                End If

                If botonAceptarCapas IsNot Nothing Then
                    EjecutarClickControl(botonAceptarCapas)
                ElseIf formulario.AcceptButton IsNot Nothing Then
                    formulario.AcceptButton.PerformClick()
                Else
                    formulario.DialogResult = DialogResult.OK
                    formulario.Close()
                End If
                Exit Sub
            End If

            Dim esAvisoCombinacion As Boolean =
                String.Equals(formulario.Name,
                              "fImportDXFCombine",
                              StringComparison.OrdinalIgnoreCase) OrElse
                String.Equals(formulario.GetType().Name,
                              "fImportDXFCombine",
                              StringComparison.OrdinalIgnoreCase)

            If esAvisoCombinacion Then
                ' Estas son las opciones recomendadas por el propio cuadro de Deswik.
                EstablecerOpcionCombinacion(formulario, "cCombine3DFaces", True)
                EstablecerOpcionCombinacion(formulario, "cSeparatePolyfaces", False)
                EstablecerOpcionCombinacion(formulario, "cCombinePoints", True)
                EstablecerOpcionCombinacion(formulario, "cDoNotPrompt", True)

                Dim temporizador As System.Windows.Forms.Timer = Nothing
                If TypeOf sender Is System.Windows.Forms.Timer Then
                    temporizador = sender
                End If
                If temporizador IsNot Nothing Then temporizador.Stop()

                Dim botonAceptar As Control = BuscarControlPorNombre(formulario, "bOK")
                Dim metodoClick As MethodInfo = Nothing
                If botonAceptar IsNot Nothing Then
                    metodoClick = botonAceptar.GetType().GetMethod(
                        "PerformClick", BindingFlags.Public Or BindingFlags.Instance)
                End If
                If metodoClick IsNot Nothing Then
                    metodoClick.Invoke(botonAceptar, Nothing)
                ElseIf formulario.AcceptButton IsNot Nothing Then
                    formulario.AcceptButton.PerformClick()
                Else
                    formulario.DialogResult = DialogResult.OK
                    formulario.Close()
                End If
                Exit Sub
            End If
        Next
    Catch
        ' Si una version futura cambia este cuadro, la importacion queda disponible
        ' para que el usuario pueda responderlo manualmente.
    End Try
End Sub

Function CapaTieneGeometria(ByVal doc As Deswik.Graphics.Application,
                            ByVal capa As Deswik.Graphics.Primaries.Layer) As Boolean
    If capa Is Nothing OrElse capa.Deleted Then Return False
    If capa.NonDeletedEntitiesCount(doc) &gt; 0 Then Return True

    For Each descendiente As Deswik.Graphics.Primaries.Layer In capa.ChildrenGetAsLayerList()
        If Not descendiente.Deleted AndAlso descendiente.NonDeletedEntitiesCount(doc) &gt; 0 Then
            Return True
        End If
    Next

    Return False
End Function

Function ObtenerOCrearCapa(ByVal doc As Deswik.Graphics.Application,
                           ByVal nombreCapa As String) As Deswik.Graphics.Primaries.Layer
    Dim capa As Deswik.Graphics.Primaries.Layer = doc.Layers.FindName(nombreCapa, True)
    If capa IsNot Nothing AndAlso capa.Deleted Then capa.Deleted = False
    If capa Is Nothing Then capa = doc.Layers.Add(nombreCapa)
    Return capa
End Function

Sub LimpiarArbolDestino(ByVal doc As Deswik.Graphics.Application,
                        ByVal capaRaiz As Deswik.Graphics.Primaries.Layer,
                        ByRef entidadesEliminadas As Integer,
                        ByRef capasEliminadas As Integer)
    entidadesEliminadas = 0
    capasEliminadas = 0
    If capaRaiz Is Nothing OrElse capaRaiz.Deleted Then Exit Sub

    doc.ActiveLayer = capaRaiz

    Dim nombresDescendientes As New List(Of String)()
    For Each nombreDescendiente As String In capaRaiz.GetChildrenChildFirst()
        nombresDescendientes.Add(nombreDescendiente)
        Dim capaDescendiente As Deswik.Graphics.Primaries.Layer =
            doc.Layers.FindName(nombreDescendiente, True)
        If capaDescendiente IsNot Nothing AndAlso Not capaDescendiente.Deleted Then
            entidadesEliminadas = entidadesEliminadas +
                                 capaDescendiente.NonDeletedEntitiesCount(doc)
            capaDescendiente.DeleteAllEntities(
                "Importacion multiple DXF/DWG - limpiar child layer destino")
        End If
    Next

    entidadesEliminadas = entidadesEliminadas + capaRaiz.NonDeletedEntitiesCount(doc)
    capaRaiz.DeleteAllEntities(
        "Importacion multiple DXF/DWG - limpiar layer raiz destino")
    doc.ModelSpace.Entities.Update()

    For Each nombreCapaAEliminar As String In nombresDescendientes
        Try
            Dim capaAEliminar As Deswik.Graphics.Primaries.Layer =
                doc.Layers.FindName(nombreCapaAEliminar, True)
            If capaAEliminar IsNot Nothing AndAlso Not capaAEliminar.Deleted Then
                If doc.Layers.Delete(nombreCapaAEliminar) Then
                    capasEliminadas = capasEliminadas + 1
                End If
            End If
        Catch
            ' Una layer protegida se conserva, ya sin geometria.
        End Try
    Next
End Sub

Sub Main()
    Dim etapa As String = "inicio"

    Try
        Dim doc As Deswik.Graphics.Application = CurrentDoc
        If doc Is Nothing Then
            MessageBox.Show("No hay un documento activo en Deswik.CAD.",
                            "Importar topografia DXF/DWG",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Warning)
            Exit Sub
        End If

        etapa = "seleccion de archivos DXF o DWG"
        Dim navegador As New OpenFileDialog()
        navegador.Title = "Seleccionar una o varias topografias DXF/DWG"
        navegador.Filter = "Topografia CAD (*.dxf;*.dwg)|*.dxf;*.dwg|Archivo DXF (*.dxf)|*.dxf|Archivo DWG (*.dwg)|*.dwg|Todos los archivos (*.*)|*.*"
        navegador.DefaultExt = "dxf"
        navegador.AddExtension = True
        navegador.CheckFileExists = True
        navegador.CheckPathExists = True
        navegador.Multiselect = True
        navegador.RestoreDirectory = True

        Dim carpetaTopografia As String = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory),
            "Nueva carpeta (2)")
        If Directory.Exists(carpetaTopografia) Then
            navegador.InitialDirectory = carpetaTopografia
        End If

        If navegador.ShowDialog() &lt;&gt; DialogResult.OK Then Exit Sub

        Dim rutasCAD As New List(Of String)()
        For Each rutaSeleccionada As String In navegador.FileNames
            Dim extensionSeleccionada As String =
                Path.GetExtension(rutaSeleccionada).ToLowerInvariant()
            If extensionSeleccionada = ".dxf" OrElse extensionSeleccionada = ".dwg" Then
                rutasCAD.Add(rutaSeleccionada)
            End If
        Next

        If rutasCAD.Count = 0 Then
            MessageBox.Show("Seleccione al menos un archivo con extension .dxf o .dwg.",
                            "Formato no compatible",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Warning)
            Exit Sub
        End If

        etapa = "configuracion del destino"
        Dim vaciarDestino As Boolean = False
        Dim aplicarColor As Boolean = True
        Dim colorRojo As Integer = 128
        Dim colorVerde As Integer = 128
        Dim colorAzul As Integer = 128
        Dim nombreDestino As String = ElegirCapaDestinoExterno(doc,
                                                               rutasCAD.Count,
                                                               vaciarDestino,
                                                               aplicarColor,
                                                               colorRojo,
                                                               colorVerde,
                                                               colorAzul)
        If nombreDestino.Length = 0 Then Exit Sub

        etapa = "creacion de la layer raiz destino"
        Dim capaDestinoRaiz As Deswik.Graphics.Primaries.Layer =
            ObtenerOCrearCapa(doc, nombreDestino)
        If capaDestinoRaiz Is Nothing Then
            Throw New Exception("No se pudo crear o recuperar la layer destino '" &amp;
                                nombreDestino &amp; "'.")
        End If
        capaDestinoRaiz.Expanded = True
        doc.ActiveLayer = capaDestinoRaiz

        Dim colorElegido As New Deswik.Graphics.Objects.Color(
            System.Drawing.Color.FromArgb(colorRojo, colorVerde, colorAzul), False)

        If aplicarColor Then
            capaDestinoRaiz.PenColor = New Deswik.Graphics.Objects.Color(colorElegido)
        End If

        Dim entidadesPreviasEliminadas As Integer = 0
        Dim capasPreviasEliminadas As Integer = 0
        If vaciarDestino Then
            etapa = "limpieza recursiva de la layer destino"
            LimpiarArbolDestino(doc,
                                capaDestinoRaiz,
                                entidadesPreviasEliminadas,
                                capasPreviasEliminadas)
        End If

        Dim archivosCorrectos As Integer = 0
        Dim totalEntidades As Integer = 0
        Dim totalChildLayers As Integer = 0
        Dim totalLayersVaciasEliminadas As Integer = 0
        Dim detallesArchivos As New List(Of String)()
        Dim erroresArchivos As New List(Of String)()
        Dim nombresPadreDelLote As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)

        For Each rutaCAD As String In rutasCAD
            Dim entidadesAnteriores As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
            Dim capasAnteriores As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
            Dim snapshotPreparado As Boolean = False

            Try
                Dim nombreArchivoCapa As String = Path.GetFileNameWithoutExtension(rutaCAD)
                If nombresPadreDelLote.Contains(nombreArchivoCapa) Then
                    nombreArchivoCapa = nombreArchivoCapa &amp; "_" &amp;
                                        Path.GetExtension(rutaCAD).TrimStart("."c).ToUpperInvariant()
                End If
                Dim nombreBaseUnico As String = nombreArchivoCapa
                Dim indiceRepetido As Integer = 2
                While nombresPadreDelLote.Contains(nombreArchivoCapa)
                    nombreArchivoCapa = nombreBaseUnico &amp; "_" &amp; indiceRepetido.ToString()
                    indiceRepetido = indiceRepetido + 1
                End While
                nombresPadreDelLote.Add(nombreArchivoCapa)

                etapa = "creacion de layer para " &amp; Path.GetFileName(rutaCAD)
                Dim nombrePadreCompleto As String = nombreDestino &amp; "\" &amp; nombreArchivoCapa
                Dim capaPadreExistente As Deswik.Graphics.Primaries.Layer =
                    doc.Layers.FindName(nombrePadreCompleto, True)
                Dim capaPadreCreada As Boolean =
                    capaPadreExistente Is Nothing OrElse capaPadreExistente.Deleted
                Dim capaPadre As Deswik.Graphics.Primaries.Layer =
                    ObtenerOCrearCapa(doc, nombrePadreCompleto)
                If capaPadre Is Nothing Then
                    Throw New Exception("No se pudo crear la layer padre '" &amp;
                                        nombrePadreCompleto &amp; "'.")
                End If
                If aplicarColor Then
                    capaPadre.PenColor = New Deswik.Graphics.Objects.Color(colorElegido)
                End If
                capaPadre.Expanded = True
                doc.ActiveLayer = capaPadre

                For Each figuraAntes As Deswik.Graphics.Primaries.Figure In doc.ModelSpace.Entities
                    entidadesAnteriores.Add(figuraAntes.GUID)
                Next
                For Each capaAntes As Deswik.Graphics.Primaries.Layer In doc.Layers
                    If Not capaAntes.Deleted Then capasAnteriores.Add(capaAntes.GUID)
                Next
                snapshotPreparado = True

                etapa = "importacion nativa de " &amp; Path.GetFileName(rutaCAD)
                Dim archivos() As String = {rutaCAD}
                Dim opcionesImportacion As New Deswik.Graphics.Settings.ImportFilesSettings()
                opcionesImportacion.Files = archivos
                opcionesImportacion.IsReload = False
                opcionesImportacion.DoPaint = False
                opcionesImportacion.UseDefaultLoader = True
                opcionesImportacion.BuildAttributes = False
                opcionesImportacion.IncludeFileNameInParentLayer = False
                opcionesImportacion.ImportAsExternalReference = False
                opcionesImportacion.ShowMessage = False
                opcionesImportacion.SelectLayers = False
                opcionesImportacion.CollapseToParent = False

                Dim configuracionDXF As Deswik.Graphics.Application.ImportCADSettings =
                    doc.ImportCadSettings
                Dim preguntarCombinacionAnterior As Boolean = configuracionDXF.PromptMerge
                Dim combinarCarasAnterior As Boolean = configuracionDXF.Merge3DFaces
                Dim separarPolifacesAnterior As Boolean = configuracionDXF.SeparateMergedPolyfaces
                Dim combinarPuntosAnterior As Boolean = configuracionDXF.MergePoints
                Dim cerradorAviso As New System.Windows.Forms.Timer()
                cerradorAviso.Interval = 1
                AddHandler cerradorAviso.Tick, AddressOf ResolverAvisoCombinacionDXF

                Try
                    configuracionDXF.PromptMerge = False
                    configuracionDXF.Merge3DFaces = True
                    configuracionDXF.SeparateMergedPolyfaces = False
                    configuracionDXF.MergePoints = True
                    cerradorAviso.Start()
                    doc.ImportFiles(opcionesImportacion)
                Finally
                    cerradorAviso.Stop()
                    RemoveHandler cerradorAviso.Tick, AddressOf ResolverAvisoCombinacionDXF
                    cerradorAviso.Dispose()

                    configuracionDXF.PromptMerge = preguntarCombinacionAnterior
                    configuracionDXF.Merge3DFaces = combinarCarasAnterior
                    configuracionDXF.SeparateMergedPolyfaces = separarPolifacesAnterior
                    configuracionDXF.MergePoints = combinarPuntosAnterior
                End Try

                etapa = "organizacion de layers de " &amp; Path.GetFileName(rutaCAD)
                Dim capasOriginalesImportadas As New List(Of String)()
                For Each capaOriginal As Deswik.Graphics.Primaries.Layer In doc.Layers
                    If Not capaOriginal.Deleted AndAlso
                       Not capasAnteriores.Contains(capaOriginal.GUID) Then
                        capasOriginalesImportadas.Add(capaOriginal.Name)
                    End If
                Next

                Dim capasDestinoArchivo As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
                Dim cantidadImportada As Integer = 0
                For Each figura As Deswik.Graphics.Primaries.Figure In doc.ModelSpace.Entities
                    If Not entidadesAnteriores.Contains(figura.GUID) Then
                        Dim capaOrigen As Deswik.Graphics.Primaries.Layer = figura.Layer
                        Dim nombreLayerCAD As String = "0"
                        If capaOrigen IsNot Nothing Then
                            nombreLayerCAD = capaOrigen.NameLast.Trim()
                            If nombreLayerCAD.Length = 0 Then nombreLayerCAD = "0"
                        End If

                        Dim nombreLayerHija As String = nombrePadreCompleto &amp; "\" &amp; nombreLayerCAD
                        Dim layerHija As Deswik.Graphics.Primaries.Layer =
                            ObtenerOCrearCapa(doc, nombreLayerHija)
                        If layerHija Is Nothing Then
                            Throw New Exception("No se pudo crear la child layer '" &amp;
                                                nombreLayerHija &amp; "'.")
                        End If

                        If aplicarColor Then
                            layerHija.PenColor = New Deswik.Graphics.Objects.Color(colorElegido)
                            figura.PenColor = New Deswik.Graphics.Objects.Color(colorElegido)
                        ElseIf capaOrigen IsNot Nothing Then
                            layerHija.PenColor =
                                New Deswik.Graphics.Objects.Color(capaOrigen.PenColor)
                        End If

                        figura.Layer = layerHija
                        capasDestinoArchivo.Add(layerHija.Name)
                        cantidadImportada = cantidadImportada + 1
                    End If
                Next

                If cantidadImportada = 0 Then
                    If capaPadreCreada AndAlso Not CapaTieneGeometria(doc, capaPadre) Then
                        doc.Layers.Delete(capaPadre.Name)
                    End If
                    Throw New Exception(
                        "Deswik no genero entidades nuevas en Model Space; revise referencias externas.")
                End If

                etapa = "eliminacion de layers vacias de " &amp; Path.GetFileName(rutaCAD)
                doc.ModelSpace.Entities.Update()
                Dim capasEliminadasArchivo As Integer = 0
                Dim huboEliminacion As Boolean = True
                While huboEliminacion
                    huboEliminacion = False
                    For Each candidata As String In capasOriginalesImportadas
                        Try
                            Dim capaVacia As Deswik.Graphics.Primaries.Layer =
                                doc.Layers.FindName(candidata, True)
                            If capaVacia IsNot Nothing AndAlso Not capaVacia.Deleted AndAlso
                               Not capasDestinoArchivo.Contains(capaVacia.Name) AndAlso
                               Not CapaTieneGeometria(doc, capaVacia) Then
                                If doc.Layers.Delete(candidata) Then
                                    capasEliminadasArchivo = capasEliminadasArchivo + 1
                                    huboEliminacion = True
                                End If
                            End If
                        Catch
                            ' Una layer referenciada o protegida se conserva.
                        End Try
                    Next
                End While

                archivosCorrectos = archivosCorrectos + 1
                totalEntidades = totalEntidades + cantidadImportada
                totalChildLayers = totalChildLayers + capasDestinoArchivo.Count
                totalLayersVaciasEliminadas =
                    totalLayersVaciasEliminadas + capasEliminadasArchivo
                detallesArchivos.Add(Path.GetFileName(rutaCAD) &amp; ": " &amp;
                                     cantidadImportada.ToString() &amp; " entidades, " &amp;
                                     capasDestinoArchivo.Count.ToString() &amp; " child layers")
            Catch exArchivo As Exception
                If snapshotPreparado Then
                    For Each figuraNueva As Deswik.Graphics.Primaries.Figure In doc.ModelSpace.Entities
                        If Not entidadesAnteriores.Contains(figuraNueva.GUID) Then
                            figuraNueva.Deleted = True
                        End If
                    Next
                    doc.ModelSpace.Entities.Update()

                    Dim capasNuevasError As New List(Of String)()
                    For Each capaNuevaError As Deswik.Graphics.Primaries.Layer In doc.Layers
                        If Not capaNuevaError.Deleted AndAlso
                           Not capasAnteriores.Contains(capaNuevaError.GUID) Then
                            capasNuevasError.Add(capaNuevaError.Name)
                        End If
                    Next
                    Dim eliminacionErrorPendiente As Boolean = True
                    While eliminacionErrorPendiente
                        eliminacionErrorPendiente = False
                        For Each nombreCapaError As String In capasNuevasError
                            Try
                                Dim capaError As Deswik.Graphics.Primaries.Layer =
                                    doc.Layers.FindName(nombreCapaError, True)
                                If capaError IsNot Nothing AndAlso Not capaError.Deleted AndAlso
                                   Not CapaTieneGeometria(doc, capaError) Then
                                    If doc.Layers.Delete(nombreCapaError) Then
                                        eliminacionErrorPendiente = True
                                    End If
                                End If
                            Catch
                            End Try
                        Next
                    End While
                End If

                erroresArchivos.Add(Path.GetFileName(rutaCAD) &amp; ": " &amp; exArchivo.Message)
            End Try
        Next

        etapa = "actualizacion de la vista"
        doc.ActiveLayer = capaDestinoRaiz
        doc.ModelSpace.Entities.Update()
        doc.OnLayersRefresh()
        doc.Redraw(True, True)
        If archivosCorrectos &gt; 0 Then doc.ZoomExtents()

        Dim resumen As String = "Importacion multiple finalizada." &amp;
                                vbCrLf &amp; vbCrLf &amp;
                                "Layer raiz: " &amp; capaDestinoRaiz.Name &amp;
                                vbCrLf &amp;
                                "Archivos seleccionados: " &amp; rutasCAD.Count.ToString() &amp;
                                vbCrLf &amp;
                                "Archivos importados: " &amp; archivosCorrectos.ToString() &amp;
                                vbCrLf &amp;
                                "Entidades importadas: " &amp; totalEntidades.ToString() &amp;
                                vbCrLf &amp;
                                "Child layers con elementos: " &amp; totalChildLayers.ToString() &amp;
                                vbCrLf &amp;
                                "Layers vacias eliminadas: " &amp;
                                totalLayersVaciasEliminadas.ToString()

        If vaciarDestino Then
            resumen = resumen &amp; vbCrLf &amp;
                      "Limpieza previa: " &amp; entidadesPreviasEliminadas.ToString() &amp;
                      " entidades y " &amp; capasPreviasEliminadas.ToString() &amp; " child layers"
        Else
            resumen = resumen &amp; vbCrLf &amp; "Limpieza previa: no"
        End If

        If aplicarColor Then
            resumen = resumen &amp; vbCrLf &amp; "Color aplicado: RGB (" &amp;
                      colorRojo.ToString() &amp; ", " &amp;
                      colorVerde.ToString() &amp; ", " &amp;
                      colorAzul.ToString() &amp; ")"
        Else
            resumen = resumen &amp; vbCrLf &amp; "Color: se conservaron los colores originales"
        End If

        If detallesArchivos.Count &gt; 0 Then
            resumen = resumen &amp; vbCrLf &amp; vbCrLf &amp; "Detalle:" &amp; vbCrLf &amp;
                      String.Join(vbCrLf, detallesArchivos.ToArray())
        End If
        If erroresArchivos.Count &gt; 0 Then
            resumen = resumen &amp; vbCrLf &amp; vbCrLf &amp; "No importados:" &amp; vbCrLf &amp;
                      String.Join(vbCrLf, erroresArchivos.ToArray())
        End If

        Dim iconoResumen As MessageBoxIcon = MessageBoxIcon.Information
        If erroresArchivos.Count &gt; 0 Then iconoResumen = MessageBoxIcon.Warning
        MessageBox.Show(resumen,
                        "Importar topografia DXF/DWG",
                        MessageBoxButtons.OK,
                        iconoResumen)
    Catch ex As Exception
        MessageBox.Show("No se pudo completar la importacion." &amp;
                        vbCrLf &amp; vbCrLf &amp;
                        "Etapa: " &amp; etapa &amp;
                        vbCrLf &amp;
                        "Detalle: " &amp; ex.Message,
                        "Importar topografia DXF/DWG",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Error)
    End Try
End Sub
