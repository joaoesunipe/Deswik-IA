End Function

Function SeleccionarLayerLimpieza(
        ByVal doc As Deswik.Graphics.Application,
        ByRef eliminarPuntos As Boolean,
        ByRef eliminarTextos As Boolean,
        ByRef eliminarSolidos As Boolean,
        ByRef eliminarDimensiones As Boolean,
        ByRef eliminarInserts As Boolean,
        ByRef eliminarLeaders As Boolean,
        ByRef eliminarLineasDisparadas As Boolean,
        ByRef longitudMinimaDisparada As Double,
        ByRef buzamientoMinimoDisparada As Double) As String
    Dim helper As String = CrearHelperTemporalLimpiezaAura()

    Dim token As String = Guid.NewGuid().ToString("N")
    Dim entrada As String = Path.Combine(
        Path.GetTempPath(), "deswik_limpieza_input_" &amp; token &amp; ".txt")
    Dim salida As String = Path.Combine(
        Path.GetTempPath(), "deswik_limpieza_output_" &amp; token &amp; ".txt")

    Dim nombres As New List(Of String)()
    For Each capa As Deswik.Graphics.Primaries.Layer In doc.Layers
        If EsLayerLimpiezaSeleccionable(capa) Then nombres.Add(capa.Name)
    Next
    nombres.Sort(StringComparer.OrdinalIgnoreCase)

    If nombres.Count = 0 Then
        MessageBox.Show("No hay layers seleccionables en el documento.",
                        "Limpieza por layer",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Information)
        Return ""
    End If

    Dim activa As String = nombres(0)
    If EsLayerLimpiezaSeleccionable(doc.ActiveLayer) Then
        activa = doc.ActiveLayer.Name
    End If

    Dim contenido As New StringBuilder()
    contenido.AppendLine(activa)
    For Each nombre As String In nombres
        contenido.AppendLine(nombre)
    Next
    File.WriteAllText(entrada, contenido.ToString(), Encoding.UTF8)

    Try
        Dim inicio As New System.Diagnostics.ProcessStartInfo()
        inicio.FileName = "powershell.exe"
        inicio.Arguments = "-NoProfile -ExecutionPolicy Bypass -STA -File """ &amp;
                           helper &amp; """ -InputPath """ &amp; entrada &amp;
                           """ -OutputPath """ &amp; salida &amp; """"
        inicio.UseShellExecute = False
        inicio.CreateNoWindow = True

        Dim proceso As System.Diagnostics.Process =
            System.Diagnostics.Process.Start(inicio)
        If proceso Is Nothing Then
            Throw New Exception("No se pudo iniciar el selector de layers.")
        End If
        proceso.WaitForExit()

        If proceso.ExitCode &lt;&gt; 0 OrElse Not File.Exists(salida) Then
            Throw New Exception("El selector termino sin devolver una respuesta.")
        End If

        Dim respuesta() As String = File.ReadAllLines(salida)
        If respuesta.Length = 0 Then
            Throw New Exception("La respuesta del selector esta vacia.")
        End If
        If String.Equals(respuesta(0),
                         "CANCEL",
                         StringComparison.OrdinalIgnoreCase) Then Return ""
        If String.Equals(respuesta(0),
                         "ERROR",
                         StringComparison.OrdinalIgnoreCase) Then
            Dim detalle As String = "Error desconocido del selector."
            If respuesta.Length &gt; 1 Then detalle = respuesta(1)
            Throw New Exception(detalle)
        End If
        If Not String.Equals(respuesta(0),
                             "OK",
                             StringComparison.OrdinalIgnoreCase) OrElse
           respuesta.Length &lt; 11 Then
            Throw New Exception("La respuesta del selector no es valida.")
        End If

        eliminarPuntos = String.Equals(respuesta(2).Trim(), "1")
        eliminarTextos = String.Equals(respuesta(3).Trim(), "1")
        eliminarSolidos = String.Equals(respuesta(4).Trim(), "1")
        eliminarDimensiones = String.Equals(respuesta(5).Trim(), "1")
        eliminarInserts = String.Equals(respuesta(6).Trim(), "1")
        eliminarLeaders = String.Equals(respuesta(7).Trim(), "1")
        eliminarLineasDisparadas = String.Equals(respuesta(8).Trim(), "1")

        If Not Double.TryParse(
                respuesta(9).Trim(),
                Globalization.NumberStyles.Float,
                Globalization.CultureInfo.InvariantCulture,
                longitudMinimaDisparada) OrElse longitudMinimaDisparada &lt;= 0.0 Then
            Throw New Exception("La longitud minima para lineas disparadas no es valida.")
        End If
        If Not Double.TryParse(
                respuesta(10).Trim(),
                Globalization.NumberStyles.Float,
                Globalization.CultureInfo.InvariantCulture,
                buzamientoMinimoDisparada) OrElse
           buzamientoMinimoDisparada &lt; 0.0 OrElse
           buzamientoMinimoDisparada &gt; 90.0 Then
            Throw New Exception("El buzamiento para lineas disparadas no es valido.")
        End If

        Return respuesta(1).Trim()
    Catch ex As Exception
        MessageBox.Show("No se pudo seleccionar la layer: " &amp; ex.Message,
                        "Limpieza por layer",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Error)
        Return ""
    Finally
        Try
            If File.Exists(entrada) Then File.Delete(entrada)
            If File.Exists(salida) Then File.Delete(salida)
            If File.Exists(helper) Then File.Delete(helper)
        Catch
        End Try
    End Try
End Function

Function EsEntidadDimension(
        ByVal figura As Deswik.Graphics.Primaries.Figure) As Boolean
    If figura Is Nothing Then Return False

    Try
        Return figura.asDimension IsNot Nothing
    Catch
        Return False
    End Try
End Function

Function EsEntidadInsert(
        ByVal figura As Deswik.Graphics.Primaries.Figure) As Boolean
    If figura Is Nothing Then Return False

    Try
        Return figura.asInsert IsNot Nothing
    Catch
        Return False
    End Try
End Function

Function EsEntidadLeader(
        ByVal figura As Deswik.Graphics.Primaries.Figure) As Boolean
    If figura Is Nothing Then Return False

    Try
        Return String.Equals(figura.TypeName,
                             "LEADER",
                             StringComparison.OrdinalIgnoreCase)
    Catch
        Return False
    End Try
End Function

Function EsEntidadPunto(
        ByVal figura As Deswik.Graphics.Primaries.Figure) As Boolean
    If figura Is Nothing Then Return False
    Return figura.asPoint IsNot Nothing OrElse _
           figura.asPoints IsNot Nothing
End Function

Function EsEntidadTexto(
        ByVal figura As Deswik.Graphics.Primaries.Figure) As Boolean
    If figura Is Nothing Then Return False
    Return figura.IsText OrElse _
           figura.IsMText OrElse _
           figura.IsBText OrElse _
           figura.asBTextInsert IsNot Nothing
End Function

Function EsEntidadSolido(
        ByVal figura As Deswik.Graphics.Primaries.Figure) As Boolean
    If figura Is Nothing Then Return False

    Try
        Dim polifaz As Deswik.Graphics.Figures.Polyface = figura.asPolyface
        If polifaz Is Nothing Then Return False
        Return polifaz.IsClosed
    Catch
        Return False
    End Try
End Function

Sub Main()
    Dim etapa As String = "inicio"

    Try
        Dim doc As Deswik.Graphics.Application = CurrentDoc
        If doc Is Nothing Then
            MessageBox.Show("No hay un documento activo en Deswik.CAD.",
                            "Limpieza por layer",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Warning)
            Exit Sub
        End If

        etapa = "seleccion de parent layer"
        Dim eliminarPuntos As Boolean = True
        Dim eliminarTextos As Boolean = True
        Dim eliminarSolidos As Boolean = True
        Dim eliminarDimensiones As Boolean = True
        Dim eliminarInserts As Boolean = True
        Dim eliminarLeaders As Boolean = True
        Dim eliminarLineasDisparadas As Boolean = False
        Dim longitudMinimaDisparada As Double = 50.0
        Dim buzamientoMinimoDisparada As Double = 85.0
        Dim nombreSeleccionado As String = SeleccionarLayerLimpieza(
            doc,
            eliminarPuntos,
            eliminarTextos,
            eliminarSolidos,
            eliminarDimensiones,
            eliminarInserts,
            eliminarLeaders,
            eliminarLineasDisparadas,
            longitudMinimaDisparada,
            buzamientoMinimoDisparada)
        If nombreSeleccionado.Length = 0 Then Exit Sub

        Dim capaRaiz As Deswik.Graphics.Primaries.Layer =
            doc.Layers.FindName(nombreSeleccionado, True)
        If capaRaiz Is Nothing OrElse capaRaiz.Deleted OrElse
           Not EsLayerLimpiezaSeleccionable(capaRaiz) Then
            MessageBox.Show("La layer seleccionada ya no existe o no es valida.",
                            "Limpieza por layer",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Warning)
            Exit Sub
        End If

        etapa = "lectura de parent y child layers"
        Dim idsCapas As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
        idsCapas.Add(capaRaiz.GUID)
        Dim cantidadChildLayers As Integer = 0
        For Each capaHija As Deswik.Graphics.Primaries.Layer In _
                capaRaiz.ChildrenGetAsLayerList()
            If capaHija IsNot Nothing AndAlso Not capaHija.Deleted Then
                If idsCapas.Add(capaHija.GUID) Then
                    cantidadChildLayers = cantidadChildLayers + 1
                End If
            End If
        Next

        etapa = "clasificacion de entidades"
        Dim entidadesAEliminar As New List(Of Deswik.Graphics.Primaries.Figure)()
        Dim puntos As Integer = 0
        Dim textos As Integer = 0
        Dim solidos As Integer = 0
        Dim dimensiones As Integer = 0
        Dim inserts As Integer = 0
        Dim leaders As Integer = 0
        Dim segmentoFiguras As New List(Of Deswik.Graphics.Primaries.Figure)()
        Dim segmentoPolilineas As New List(Of Deswik.Graphics.Figures.Polyline)()
        Dim segmentoIndices As New List(Of Integer)()
        Dim segmentoInicios As New List(Of Deswik.Graphics.Geometry.Point)()
        Dim segmentoFinales As New List(Of Deswik.Graphics.Geometry.Point)()
        Dim segmentoLongitudes As New List(Of Double)()
        Dim segmentoBuzamientos As New List(Of Double)()
        Dim indicesDisparados As New List(Of Integer)()

        For Each figura As Deswik.Graphics.Primaries.Figure In _
                doc.ModelSpace.Entities
            If figura Is Nothing OrElse figura.Deleted OrElse
               figura.Layer Is Nothing OrElse
               Not idsCapas.Contains(figura.Layer.GUID) Then Continue For

            If eliminarPuntos AndAlso EsEntidadPunto(figura) Then
                entidadesAEliminar.Add(figura)
                puntos = puntos + 1
            ElseIf eliminarTextos AndAlso EsEntidadTexto(figura) Then
                entidadesAEliminar.Add(figura)
                textos = textos + 1
            ElseIf eliminarSolidos AndAlso EsEntidadSolido(figura) Then
                entidadesAEliminar.Add(figura)
                solidos = solidos + 1
            ElseIf eliminarDimensiones AndAlso EsEntidadDimension(figura) Then
                entidadesAEliminar.Add(figura)
                dimensiones = dimensiones + 1
            ElseIf eliminarInserts AndAlso EsEntidadInsert(figura) Then
                entidadesAEliminar.Add(figura)
                inserts = inserts + 1
            ElseIf eliminarLeaders AndAlso EsEntidadLeader(figura) Then
                entidadesAEliminar.Add(figura)
                leaders = leaders + 1
            End If
        Next

        If eliminarLineasDisparadas Then
            etapa = "deteccion de lineas disparadas"
            For Each figuraSegmentos As Deswik.Graphics.Primaries.Figure In _
                    doc.ModelSpace.Entities
                If figuraSegmentos Is Nothing OrElse figuraSegmentos.Deleted OrElse
                   figuraSegmentos.Layer Is Nothing OrElse
                   Not idsCapas.Contains(figuraSegmentos.Layer.GUID) Then Continue For

                Dim polilineaSegmentos As Deswik.Graphics.Figures.Polyline =
                    figuraSegmentos.asPolyline
                If polilineaSegmentos Is Nothing Then
                    If figuraSegmentos.asLine Is Nothing Then Continue For
                    polilineaSegmentos = figuraSegmentos.ToPolyline(1)
                End If
                If polilineaSegmentos Is Nothing OrElse polilineaSegmentos.Closed OrElse
                   polilineaSegmentos.VertexCount &lt; 2 Then Continue For

                For indiceSegmento As Integer = 0 To _
                        polilineaSegmentos.VertexCount - 2
                    Dim inicioSegmento As Deswik.Graphics.Geometry.Point =
                        polilineaSegmentos.GetVertex(indiceSegmento)
                    Dim finSegmento As Deswik.Graphics.Geometry.Point =
                        polilineaSegmentos.GetVertex(indiceSegmento + 1)
                    If inicioSegmento Is Nothing OrElse finSegmento Is Nothing Then
                        Continue For
                    End If

                    Dim dxSegmento As Double = finSegmento.x - inicioSegmento.x
                    Dim dySegmento As Double = finSegmento.y - inicioSegmento.y
                    Dim dzSegmento As Double = finSegmento.z - inicioSegmento.z
                    Dim horizontalSegmento As Double = Math.Sqrt(
                        dxSegmento * dxSegmento + dySegmento * dySegmento)
                    Dim longitudSegmento As Double = Math.Sqrt(
                        horizontalSegmento * horizontalSegmento +
                        dzSegmento * dzSegmento)
                    If longitudSegmento &lt;= 0.000000001 Then Continue For

                    segmentoFiguras.Add(figuraSegmentos)
                    segmentoPolilineas.Add(polilineaSegmentos)
                    segmentoIndices.Add(indiceSegmento)
                    segmentoInicios.Add(inicioSegmento)
                    segmentoFinales.Add(finSegmento)
                    segmentoLongitudes.Add(longitudSegmento)
                    segmentoBuzamientos.Add(
                        Math.Atan2(Math.Abs(dzSegmento), horizontalSegmento) *
                        180.0 / Math.PI)
                Next
            Next

            Const maxSegmentosAnalizables As Integer = 250000
            If segmentoFiguras.Count &gt; maxSegmentosAnalizables Then
                MessageBox.Show(
                    "La layer seleccionada contiene " &amp;
                    segmentoFiguras.Count.ToString() &amp;
                    " segmentos. Para proteger Deswik, el analisis se detuvo " &amp;
                    "antes de modificar el documento." &amp; vbCrLf &amp; vbCrLf &amp;
                    "Seleccione una parent layer mas especifica. Limite: " &amp;
                    maxSegmentosAnalizables.ToString() &amp; " segmentos.",
                    "Limpieza por layer",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning)
                Exit Sub
            End If

            Dim toleranciaUnion As Double = 0.1
            Dim cosenoMinimo As Double = Math.Cos(25.0 * Math.PI / 180.0)

            ' Indexa solamente los extremos cercanos. Esto evita comparar cada
            ' segmento contra todos los demas en topografias grandes.
            Dim segmentosPorCelda As New Dictionary(Of String, List(Of Integer))(
                StringComparer.Ordinal)
            For indiceIndice As Integer = 0 To segmentoFiguras.Count - 1
                For extremoIndice As Integer = 0 To 1
                    Dim puntoIndice As Deswik.Graphics.Geometry.Point =
                        segmentoInicios(indiceIndice)
                    If extremoIndice = 1 Then
                        puntoIndice = segmentoFinales(indiceIndice)
                    End If

                    Dim celdaIndiceX As Long =
                        CLng(Math.Floor(puntoIndice.x / toleranciaUnion))
                    Dim celdaIndiceY As Long =
                        CLng(Math.Floor(puntoIndice.y / toleranciaUnion))
                    Dim celdaIndiceZ As Long =
                        CLng(Math.Floor(puntoIndice.z / toleranciaUnion))
                    Dim claveIndice As String =
                        celdaIndiceX.ToString() &amp; "|" &amp;
                        celdaIndiceY.ToString() &amp; "|" &amp;
                        celdaIndiceZ.ToString()
                    Dim listaIndice As List(Of Integer) = Nothing
                    If Not segmentosPorCelda.TryGetValue(
                            claveIndice, listaIndice) Then
                        listaIndice = New List(Of Integer)()
                        segmentosPorCelda.Add(claveIndice, listaIndice)
                    End If
                    listaIndice.Add(indiceIndice)
                Next
            Next

            For indiceCandidato As Integer = 0 To segmentoFiguras.Count - 1
                If segmentoLongitudes(indiceCandidato) &lt;= longitudMinimaDisparada OrElse
                   segmentoBuzamientos(indiceCandidato) &lt;= buzamientoMinimoDisparada Then
                    Continue For
                End If

                Dim coherenteInicio As Boolean = False
                Dim coherenteFin As Boolean = False
                Dim inicioCandidato As Deswik.Graphics.Geometry.Point =
                    segmentoInicios(indiceCandidato)
                Dim finCandidato As Deswik.Graphics.Geometry.Point =
                    segmentoFinales(indiceCandidato)
                Dim ax As Double = finCandidato.x - inicioCandidato.x
                Dim ay As Double = finCandidato.y - inicioCandidato.y
                Dim az As Double = finCandidato.z - inicioCandidato.z

                For extremoCandidato As Integer = 0 To 1
                    Dim puntoCandidato As Deswik.Graphics.Geometry.Point =
                        inicioCandidato
                    If extremoCandidato = 1 Then puntoCandidato = finCandidato

                    Dim celdaX As Long =
                        CLng(Math.Floor(puntoCandidato.x / toleranciaUnion))
                    Dim celdaY As Long =
                        CLng(Math.Floor(puntoCandidato.y / toleranciaUnion))
                    Dim celdaZ As Long =
                        CLng(Math.Floor(puntoCandidato.z / toleranciaUnion))
                    Dim coherenteExtremo As Boolean = False
                    Dim indicesRevisados As New HashSet(Of Integer)()

                    For desplazamientoX As Integer = -1 To 1
                        If coherenteExtremo Then Exit For
                        For desplazamientoY As Integer = -1 To 1
                            If coherenteExtremo Then Exit For
                            For desplazamientoZ As Integer = -1 To 1
                                If coherenteExtremo Then Exit For
                                Dim claveVecina As String =
                                    (celdaX + desplazamientoX).ToString() &amp; "|" &amp;
                                    (celdaY + desplazamientoY).ToString() &amp; "|" &amp;
                                    (celdaZ + desplazamientoZ).ToString()
                                Dim listaVecina As List(Of Integer) = Nothing
                                If Not segmentosPorCelda.TryGetValue(
                                        claveVecina, listaVecina) Then
                                    Continue For
                                End If

                                For Each indiceOtro As Integer In listaVecina
                                    If indiceOtro = indiceCandidato OrElse
                                       Not indicesRevisados.Add(indiceOtro) Then
                                        Continue For
                                    End If
                                    If String.Equals(
                                            segmentoFiguras(indiceCandidato).GUID,
                                            segmentoFiguras(indiceOtro).GUID,
                                            StringComparison.OrdinalIgnoreCase) AndAlso
                                       segmentoIndices(indiceCandidato) =
                                            segmentoIndices(indiceOtro) Then
                                        Continue For
                                    End If

                                    Dim tocaExtremo As Boolean =
                                        puntoCandidato.Distance3D(
                                            segmentoInicios(indiceOtro)) &lt;=
                                                toleranciaUnion OrElse
                                        puntoCandidato.Distance3D(
                                            segmentoFinales(indiceOtro)) &lt;=
                                                toleranciaUnion
                                    If Not tocaExtremo Then Continue For

                                    Dim bx As Double =
                                        segmentoFinales(indiceOtro).x -
                                        segmentoInicios(indiceOtro).x
                                    Dim by As Double =
                                        segmentoFinales(indiceOtro).y -
                                        segmentoInicios(indiceOtro).y
                                    Dim bz As Double =
                                        segmentoFinales(indiceOtro).z -
                                        segmentoInicios(indiceOtro).z
                                    Dim producto As Double =
                                        Math.Abs(ax * bx + ay * by + az * bz)
                                    Dim denominador As Double =
                                        segmentoLongitudes(indiceCandidato) *
                                        segmentoLongitudes(indiceOtro)
                                    If denominador &gt; 0.000000001 AndAlso
                                       producto / denominador &gt;= cosenoMinimo Then
                                        coherenteExtremo = True
                                        Exit For
                                    End If
                                Next
                            Next
                        Next
                    Next

                    If extremoCandidato = 0 Then
                        coherenteInicio = coherenteExtremo
                    Else
                        coherenteFin = coherenteExtremo
                    End If
                Next

                If Not coherenteInicio AndAlso Not coherenteFin Then
                    indicesDisparados.Add(indiceCandidato)
                End If
            Next
        End If

        Dim total As Integer = entidadesAEliminar.Count + indicesDisparados.Count
        Dim detalleConteo As New StringBuilder()
        If eliminarPuntos Then
            detalleConteo.AppendLine("  Puntos: " &amp; puntos.ToString())
        End If
        If eliminarTextos Then
            detalleConteo.AppendLine("  Textos: " &amp; textos.ToString())
        End If
        If eliminarSolidos Then
            detalleConteo.AppendLine("  Solidos cerrados: " &amp; solidos.ToString())
        End If
        If eliminarDimensiones Then
            detalleConteo.AppendLine("  Dimensiones: " &amp; dimensiones.ToString())
        End If
        If eliminarInserts Then
            detalleConteo.AppendLine("  Inserts / bloques: " &amp; inserts.ToString())
        End If
        If eliminarLeaders Then
            detalleConteo.AppendLine("  Flechas / leaders: " &amp; leaders.ToString())
        End If
        If eliminarLineasDisparadas Then
            detalleConteo.AppendLine(
                "  Segmentos de lineas disparadas: " &amp;
                indicesDisparados.Count.ToString() &amp;
                " (longitud &gt; " &amp; longitudMinimaDisparada.ToString("0.##") &amp;
                " m; |buzamiento| &gt; " &amp;
                buzamientoMinimoDisparada.ToString("0.#") &amp; " grados)")
        End If

        If total = 0 Then
            MessageBox.Show(
                "No se encontraron entidades de los tipos seleccionados en:" &amp;
                vbCrLf &amp; nombreSeleccionado &amp; vbCrLf &amp; vbCrLf &amp;
                "Child layers revisadas: " &amp; cantidadChildLayers.ToString() &amp;
                vbCrLf &amp; vbCrLf &amp; detalleConteo.ToString() &amp; vbCrLf &amp;
                "No se modifico el documento.",
                "Limpieza por layer",
                MessageBoxButtons.OK,
                MessageBoxIcon.Information)
            Exit Sub
        End If

        etapa = "confirmacion"
        Dim notaGeometria As String =
            "Las polilineas, superficies abiertas y demas geometria se conservaran."
        If eliminarLineasDisparadas Then
            notaGeometria =
                "Las polilineas con segmentos disparados se cortaran; " &amp;
                "solo se quitaran los segmentos detectados."
        End If

        Dim mensaje As String =
            "Layer seleccionada:" &amp; vbCrLf &amp; nombreSeleccionado &amp; vbCrLf &amp; vbCrLf &amp;
            "Alcance: parent layer + " &amp; cantidadChildLayers.ToString() &amp;
             " child layer(s)" &amp; vbCrLf &amp; vbCrLf &amp;
             "Entidades que se eliminaran:" &amp; vbCrLf &amp;
             detalleConteo.ToString() &amp;
             "  TOTAL: " &amp; total.ToString() &amp; vbCrLf &amp; vbCrLf &amp;
            notaGeometria &amp;
            vbCrLf &amp; vbCrLf &amp;
            "¿Desea continuar?"

        Dim confirmar As DialogResult = MessageBox.Show(
            mensaje,
            "Confirmar limpieza por layer",
            MessageBoxButtons.YesNo,
            MessageBoxIcon.Warning,
            MessageBoxDefaultButton.Button2)
        If confirmar &lt;&gt; DialogResult.Yes Then Exit Sub

        etapa = "eliminacion de entidades"
        For Each figuraEliminar As Deswik.Graphics.Primaries.Figure In entidadesAEliminar
            figuraEliminar.Deleted = True
        Next
        If eliminarLineasDisparadas AndAlso indicesDisparados.Count &gt; 0 Then
            etapa = "eliminacion de lineas disparadas"
            Dim lineasEliminadas As New HashSet(Of String)(
                StringComparer.OrdinalIgnoreCase)
            Dim polilineasProcesadas As New HashSet(Of String)(
                StringComparer.OrdinalIgnoreCase)

            For Each indiceDisparado As Integer In indicesDisparados
                Dim figuraFuente As Deswik.Graphics.Primaries.Figure =
                    segmentoFiguras(indiceDisparado)
                If figuraFuente.asPolyline Is Nothing Then
                    If lineasEliminadas.Add(figuraFuente.GUID) Then
                        figuraFuente.Deleted = True
                    End If
                Else
                    Dim polilineaFuente As Deswik.Graphics.Figures.Polyline =
                        segmentoPolilineas(indiceDisparado)
                    If Not polilineasProcesadas.Add(polilineaFuente.GUID) Then
                        Continue For
                    End If

                    Dim indicesCorte As New List(Of Integer)()
                    For Each indiceCoincidente As Integer In indicesDisparados
                        If String.Equals(polilineaFuente.GUID,
                                         segmentoPolilineas(indiceCoincidente).GUID,
                                         StringComparison.OrdinalIgnoreCase) AndAlso
                           Not indicesCorte.Contains(
                               segmentoIndices(indiceCoincidente)) Then
                            indicesCorte.Add(segmentoIndices(indiceCoincidente))
                        End If
                    Next
                    indicesCorte.Sort()

                    If indicesCorte.Count &gt;= polilineaFuente.VertexCount - 1 Then
                        polilineaFuente.Deleted = True
                        Continue For
                    End If

                    Dim partes As Deswik.Graphics.Collections.PolylineList =
                        polilineaFuente.DeleteSegments(indicesCorte)
                    polilineaFuente.Deleted = True
                    If partes Is Nothing Then Continue For
                    For Each parte As Deswik.Graphics.Figures.Polyline In partes
                        If parte IsNot Nothing AndAlso parte.VertexCount &gt;= 2 Then
                            doc.ModelSpace.Entities.Add(parte)
                        End If
                    Next
                End If
            Next
        End If

        doc.ModelSpace.Entities.Update()
        doc.OnLayersRefresh()
        doc.Redraw(True, True)

        MessageBox.Show(
             "Limpieza terminada." &amp; vbCrLf &amp; vbCrLf &amp;
             "Layer: " &amp; nombreSeleccionado &amp; vbCrLf &amp;
             "Child layers incluidas: " &amp; cantidadChildLayers.ToString() &amp; vbCrLf &amp;
             "Entidades eliminadas:" &amp; vbCrLf &amp;
             detalleConteo.ToString() &amp;
             "Total de entidades/segmentos eliminado: " &amp; total.ToString(),
            "Limpieza por layer",
            MessageBoxButtons.OK,
            MessageBoxIcon.Information)
    Catch ex As Exception
        MessageBox.Show(
            "No se pudo completar la limpieza." &amp; vbCrLf &amp;
            "Etapa: " &amp; etapa &amp; vbCrLf &amp; vbCrLf &amp;
            ex.GetType().FullName &amp; vbCrLf &amp; ex.Message,
            "Limpieza por layer",
            MessageBoxButtons.OK,
            MessageBoxIcon.Error)
    End Try
End Sub
