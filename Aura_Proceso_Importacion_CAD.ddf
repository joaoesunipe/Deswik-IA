Imports System
Imports System.IO
Imports System.Collections.Generic
Imports System.Windows.Forms
Imports System.Drawing
Imports System.Reflection

Dim cfgCadCapasDisponibles As List(Of String)
Dim cfgCadCapaActiva As String
Dim cfgCadCantidadArchivos As Integer
Dim cfgCadResultado As DialogResult
Dim cfgCadNombreDestino As String
Dim cfgCadVaciarDestino As Boolean
Dim cfgCadAplicarGris As Boolean
Dim cfgCadError As String
Dim cfgCadEventoFinalizado As System.Threading.ManualResetEvent

Sub MostrarConfiguracionCadIndependiente()
    Try
        Dim cfgCadForm As New Form()
        cfgCadForm.Text = "Importacion multiple de topografia DXF/DWG"
        cfgCadForm.StartPosition = FormStartPosition.CenterScreen
        cfgCadForm.FormBorderStyle = FormBorderStyle.FixedDialog
        cfgCadForm.MinimizeBox = False
        cfgCadForm.MaximizeBox = False
        cfgCadForm.ShowInTaskbar = True
        cfgCadForm.ClientSize = New System.Drawing.Size(590, 300)

        Dim cfgCadLblTitulo As New Label()
        cfgCadLblTitulo.Text = "Layer raiz existente o nueva (puede escribir un nombre):"
        cfgCadLblTitulo.AutoSize = True
        cfgCadLblTitulo.Location = New System.Drawing.Point(18, 18)

        Dim cfgCadComboDestino As New ComboBox()
        cfgCadComboDestino.Location = New System.Drawing.Point(18, 43)
        cfgCadComboDestino.Size = New System.Drawing.Size(550, 25)
        cfgCadComboDestino.DropDownStyle = ComboBoxStyle.DropDown
        For Each cfgCadNombreDisponible As String In cfgCadCapasDisponibles
            cfgCadComboDestino.Items.Add(cfgCadNombreDisponible)
        Next
        cfgCadComboDestino.Text = cfgCadCapaActiva

        Dim cfgCadLblCantidad As New Label()
        cfgCadLblCantidad.Text = "Archivos CAD seleccionados: " &amp; cfgCadCantidadArchivos.ToString()
        cfgCadLblCantidad.AutoSize = True
        cfgCadLblCantidad.Location = New System.Drawing.Point(18, 84)

        Dim cfgCadChkVaciar As New CheckBox()
        cfgCadChkVaciar.Text = "Eliminar previamente la geometria y todas las child layers del destino"
        cfgCadChkVaciar.Checked = False
        cfgCadChkVaciar.AutoSize = True
        cfgCadChkVaciar.Location = New System.Drawing.Point(18, 119)

        Dim cfgCadChkGris As New CheckBox()
        cfgCadChkGris.Text = "Convertir toda la geometria importada a gris RGB (128, 128, 128)"
        cfgCadChkGris.Checked = True
        cfgCadChkGris.AutoSize = True
        cfgCadChkGris.Location = New System.Drawing.Point(18, 149)

        Dim cfgCadLblNota As New Label()
        cfgCadLblNota.Text = "Se importan todas las layers. Las vacias se eliminan y cada archivo conserva sus child layers."
        cfgCadLblNota.AutoSize = True
        cfgCadLblNota.Location = New System.Drawing.Point(18, 185)

        Dim cfgCadBtnImportar As New Button()
        cfgCadBtnImportar.Text = "Importar"
        cfgCadBtnImportar.DialogResult = DialogResult.OK
        cfgCadBtnImportar.Location = New System.Drawing.Point(392, 247)
        cfgCadBtnImportar.Size = New System.Drawing.Size(84, 30)

        Dim cfgCadBtnCancelar As New Button()
        cfgCadBtnCancelar.Text = "Cancelar"
        cfgCadBtnCancelar.DialogResult = DialogResult.Cancel
        cfgCadBtnCancelar.Location = New System.Drawing.Point(484, 247)
        cfgCadBtnCancelar.Size = New System.Drawing.Size(84, 30)

        cfgCadForm.Controls.Add(cfgCadLblTitulo)
        cfgCadForm.Controls.Add(cfgCadComboDestino)
        cfgCadForm.Controls.Add(cfgCadLblCantidad)
        cfgCadForm.Controls.Add(cfgCadChkVaciar)
        cfgCadForm.Controls.Add(cfgCadChkGris)
        cfgCadForm.Controls.Add(cfgCadLblNota)
        cfgCadForm.Controls.Add(cfgCadBtnImportar)
        cfgCadForm.Controls.Add(cfgCadBtnCancelar)
        cfgCadForm.AcceptButton = cfgCadBtnImportar
        cfgCadForm.CancelButton = cfgCadBtnCancelar

        Do
            cfgCadResultado = cfgCadForm.ShowDialog()
            If cfgCadResultado &lt;&gt; DialogResult.OK Then Exit Do

            cfgCadNombreDestino = cfgCadComboDestino.Text.Trim()
            If cfgCadNombreDestino.Length &gt; 0 Then
                cfgCadVaciarDestino = cfgCadChkVaciar.Checked
                cfgCadAplicarGris = cfgCadChkGris.Checked
                Exit Do
            End If

            MessageBox.Show("Seleccione una layer existente o escriba el nombre de una nueva.",
                            "Layer requerida",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Warning)
        Loop
    Catch cfgCadEx As Exception
        cfgCadError = cfgCadEx.Message
        cfgCadResultado = DialogResult.Abort
    Finally
        If cfgCadEventoFinalizado IsNot Nothing Then cfgCadEventoFinalizado.Set()
    End Try
End Sub

Function ElegirCapaDestinoEnHilo(ByVal cfgCadDoc As Deswik.Graphics.Application,
                                 ByVal cfgCadConteo As Integer,
                                 ByRef cfgCadVaciarSalida As Boolean,
                                 ByRef cfgCadGrisSalida As Boolean) As String
    cfgCadCapasDisponibles = New List(Of String)()
    For Each cfgCadLayer As Deswik.Graphics.Primaries.Layer In cfgCadDoc.Layers
        If Not cfgCadLayer.Deleted Then cfgCadCapasDisponibles.Add(cfgCadLayer.Name)
    Next

    cfgCadCapaActiva = "IMPORTACION_CAD"
    If cfgCadDoc.ActiveLayer IsNot Nothing AndAlso Not cfgCadDoc.ActiveLayer.Deleted Then
        cfgCadCapaActiva = cfgCadDoc.ActiveLayer.Name
    End If
    cfgCadCantidadArchivos = cfgCadConteo
    cfgCadResultado = DialogResult.None
    cfgCadNombreDestino = ""
    cfgCadVaciarDestino = False
    cfgCadAplicarGris = True
    cfgCadError = ""
    cfgCadEventoFinalizado = New System.Threading.ManualResetEvent(False)

    Dim cfgCadHilo As New System.Threading.Thread(AddressOf MostrarConfiguracionCadIndependiente)
    cfgCadHilo.IsBackground = True
    cfgCadHilo.SetApartmentState(System.Threading.ApartmentState.STA)
    cfgCadHilo.Start()
    cfgCadEventoFinalizado.WaitOne()

    If cfgCadError.Length &gt; 0 Then
        MessageBox.Show("No se pudo abrir la configuracion: " &amp; cfgCadError,
                        "Importacion DXF/DWG",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Error)
        Return ""
    End If
    If cfgCadResultado &lt;&gt; DialogResult.OK Then Return ""

    cfgCadVaciarSalida = cfgCadVaciarDestino
    cfgCadGrisSalida = cfgCadAplicarGris
    Return cfgCadNombreDestino
End Function

Function EsLayerDestinoSeleccionable(ByVal extCadLayer As Deswik.Graphics.Primaries.Layer) As Boolean
    If extCadLayer Is Nothing OrElse extCadLayer.Deleted Then Return False

    Dim extCadNombre As String = extCadLayer.Name.Trim()
    If extCadNombre.Length = 0 Then Return False

    Dim extCadPartes() As String = extCadNombre.Split(New Char() {"\"c})
    Dim extCadNombreRaiz As String = extCadPartes(0)

    If String.Equals(extCadNombreRaiz,
                     "_DWG_HIDDEN_GRAPHICS",
                     StringComparison.OrdinalIgnoreCase) Then Return False
    If String.Equals(extCadNombreRaiz,
                     "_DW_HIDDEN_GRAPHICS",
                     StringComparison.OrdinalIgnoreCase) Then Return False
    If String.Equals(extCadNombreRaiz,
                     "DWG_SETTINGS",
                     StringComparison.OrdinalIgnoreCase) Then Return False
    If String.Equals(extCadNombreRaiz,
                     "_DW_SETTINGS",
                     StringComparison.OrdinalIgnoreCase) Then Return False
    If extCadNombreRaiz.StartsWith("_DWG_",
                                   StringComparison.OrdinalIgnoreCase) Then Return False
    If extCadNombreRaiz.StartsWith("_DW_",
                                   StringComparison.OrdinalIgnoreCase) Then Return False

    Return True
End Function

