Function SeleccionarParentsDelPanel(
        ByVal doc As Deswik.Graphics.Application) As List(Of String)
    Dim resultado As New List(Of String)()
    Dim helper As String = CrearHelperTemporalConsolidacionAura()

    Dim token As String = Guid.NewGuid().ToString("N")
    Dim entrada As String = Path.Combine(
        Path.GetTempPath(), "deswik_consolidar_input_" &amp; token &amp; ".txt")
    Dim salida As String = Path.Combine(
        Path.GetTempPath(), "deswik_consolidar_output_" &amp; token &amp; ".txt")

    Try
        Dim capasDelPanel As New List(Of Deswik.Graphics.Primaries.Layer)()
        For Each capa As Deswik.Graphics.Primaries.Layer In doc.Layers
            If EsLayerConsolidable(capa) Then
                capasDelPanel.Add(capa)
            End If
        Next

        If capasDelPanel.Count = 0 Then
            MessageBox.Show("No hay layers seleccionables en el panel Layer Control.",
                            "Consolidar child layers",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Information)
            Return resultado
        End If

        Dim activa As String = ""
        If EsLayerConsolidable(doc.ActiveLayer) Then
            activa = doc.ActiveLayer.Name
        End If

        Dim contenido As New StringBuilder()
        contenido.AppendLine(activa)
        For Each capaDelPanel As Deswik.Graphics.Primaries.Layer In capasDelPanel
            If TieneDescendientesConsolidados(capaDelPanel) Then
                contenido.Append("1")
            Else
                contenido.Append("0")
            End If
            contenido.Append(vbTab)
            contenido.AppendLine(capaDelPanel.Name)
        Next
        File.WriteAllText(entrada, contenido.ToString(), Encoding.UTF8)

        Dim inicio As New System.Diagnostics.ProcessStartInfo()
        inicio.FileName = "powershell.exe"
        inicio.Arguments = "-NoProfile -ExecutionPolicy Bypass -STA -File """ &amp;
                           helper &amp; """ -InputPath """ &amp; entrada &amp;
                           """ -OutputPath """ &amp; salida &amp; """"
        inicio.UseShellExecute = False
        inicio.CreateNoWindow = True

        Dim proceso As System.Diagnostics.Process =
            System.Diagnostics.Process.Start(inicio)
        If proceso Is Nothing Then
            Throw New Exception("No se pudo iniciar el selector de layers.")
        End If
        proceso.WaitForExit()

        If proceso.ExitCode &lt;&gt; 0 OrElse Not File.Exists(salida) Then
            Throw New Exception("El selector termino sin devolver una respuesta.")
        End If

        Dim respuesta() As String = File.ReadAllLines(salida)
        If respuesta.Length = 0 Then
            Throw New Exception("La respuesta del selector esta vacia.")
        End If
        If String.Equals(respuesta(0),
                         "CANCEL",
                         StringComparison.OrdinalIgnoreCase) Then Return resultado
        If String.Equals(respuesta(0),
                         "ERROR",
                         StringComparison.OrdinalIgnoreCase) Then
            Dim detalle As String = "Error desconocido del selector."
            If respuesta.Length &gt; 1 Then detalle = respuesta(1)
            Throw New Exception(detalle)
        End If
        If Not String.Equals(respuesta(0),
                             "OK",
                             StringComparison.OrdinalIgnoreCase) Then
            Throw New Exception("La respuesta del selector no es valida.")
        End If

        For indice As Integer = 1 To respuesta.Length - 1
            Dim nombre As String = respuesta(indice).Trim()
            If nombre.Length &gt; 0 AndAlso Not resultado.Contains(nombre) Then
                resultado.Add(nombre)
            End If
        Next

        If resultado.Count = 0 Then
            Throw New Exception("No se selecciono ninguna parent layer.")
        End If
    Catch ex As Exception
        MessageBox.Show("No se pudieron seleccionar las parent layers: " &amp; ex.Message,
                        "Consolidar child layers",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Error)
        resultado.Clear()
    Finally
        Try
            If File.Exists(entrada) Then File.Delete(entrada)
            If File.Exists(salida) Then File.Delete(salida)
            If File.Exists(helper) Then File.Delete(helper)
        Catch
        End Try
    End Try

    Return resultado
End Function

Sub Main()
    Try
        Dim doc As Deswik.Graphics.Application = CurrentDoc
        If doc Is Nothing Then
            MessageBox.Show("No hay un documento activo.",
                            "Consolidar child layers",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Information)
            Exit Sub
        End If

        Dim nombresSeleccionados As List(Of String) =
            SeleccionarParentsDelPanel(doc)
        If nombresSeleccionados.Count = 0 Then Exit Sub

        Dim parents As New List(Of Deswik.Graphics.Primaries.Layer)()
        For Each nombreSeleccionado As String In nombresSeleccionados
            Dim parentValidada As Deswik.Graphics.Primaries.Layer =
                doc.Layers.FindName(nombreSeleccionado, True)
            If parentValidada Is Nothing OrElse parentValidada.Deleted OrElse
               Not EsLayerConsolidable(parentValidada) OrElse
               Not TieneDescendientesConsolidados(parentValidada) Then
                MessageBox.Show(
                    "La layer ya no es una parent valida del panel Layer Control:" &amp; vbCrLf &amp;
                    nombreSeleccionado,
                    "Consolidar child layers",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning)
                Exit Sub
            End If
            parents.Add(parentValidada)
        Next

        For indiceA As Integer = 0 To parents.Count - 1
            For indiceB As Integer = indiceA + 1 To parents.Count - 1
                If EsNombreDescendiente(parents(indiceA).Name, parents(indiceB).Name) OrElse
                   EsNombreDescendiente(parents(indiceB).Name, parents(indiceA).Name) Then
                    MessageBox.Show(
                        "No se puede seleccionar simultaneamente una parent y otra " &amp;
                        "parent incluida dentro de ella:" &amp; vbCrLf &amp; vbCrLf &amp;
                        parents(indiceA).Name &amp; vbCrLf &amp; parents(indiceB).Name,
                        "Consolidar child layers",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Warning)
                    Exit Sub
                End If
            Next
        Next

        Dim destinoPorGuid As New Dictionary(Of String, Deswik.Graphics.Primaries.Layer)(
            StringComparer.OrdinalIgnoreCase)
        Dim childNamesChildFirst As New List(Of String)()
        Dim childNamesUnicos As New HashSet(Of String)(
            StringComparer.OrdinalIgnoreCase)
        Dim totalEntidadesEstimadas As Integer = 0

        For Each parentObjetivo As Deswik.Graphics.Primaries.Layer In parents
            For Each nombreChild As String In parentObjetivo.GetChildrenChildFirst()
                Dim childOrigen As Deswik.Graphics.Primaries.Layer =
                    doc.Layers.FindName(nombreChild, True)
                If childOrigen Is Nothing OrElse childOrigen.Deleted Then Continue For

                If destinoPorGuid.ContainsKey(childOrigen.GUID) Then
                    MessageBox.Show(
                        "Se detecto una child layer compartida entre selecciones:" &amp; vbCrLf &amp;
                        childOrigen.Name,
                        "Consolidar child layers",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Warning)
                    Exit Sub
                End If

                destinoPorGuid.Add(childOrigen.GUID, parentObjetivo)
                If childNamesUnicos.Add(childOrigen.Name) Then
                    childNamesChildFirst.Add(childOrigen.Name)
                    totalEntidadesEstimadas = totalEntidadesEstimadas +
                                             childOrigen.NonDeletedEntitiesCount(doc)
                End If
            Next
        Next

        If childNamesChildFirst.Count = 0 Then
            MessageBox.Show("Las parent layers seleccionadas ya no tienen child layers.",
                            "Consolidar child layers",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Information)
            Exit Sub
        End If

        Dim listaParents As New StringBuilder()
        For Each parentResumen As Deswik.Graphics.Primaries.Layer In parents
            listaParents.AppendLine("- " &amp; parentResumen.Name)
        Next

        Dim confirmacion As DialogResult = MessageBox.Show(
            "Se consolidaran las siguientes parent layers:" &amp; vbCrLf &amp; vbCrLf &amp;
            listaParents.ToString() &amp; vbCrLf &amp;
            "Child layers que se intentaran eliminar: " &amp;
            childNamesChildFirst.Count.ToString() &amp; vbCrLf &amp;
            "Entidades estimadas que cambiaran de layer: " &amp;
            totalEntidadesEstimadas.ToString() &amp; vbCrLf &amp; vbCrLf &amp;
            "Cada entidad pasara a su propia parent seleccionada. " &amp;
            "Las entidades con propiedades BYLAYER adoptaran la apariencia de esa parent." &amp;
            vbCrLf &amp; vbCrLf &amp; "Deseas continuar?",
            "Confirmar consolidacion",
            MessageBoxButtons.YesNo,
            MessageBoxIcon.Warning,
            MessageBoxDefaultButton.Button2)
        If confirmacion &lt;&gt; DialogResult.Yes Then Exit Sub

        doc.ActiveLayer = parents(0)

        Dim entidadesMovidas As Integer = 0
        Dim erroresEntidades As Integer = 0
        Dim primerosErrores As New List(Of String)()

        For Each figura As Deswik.Graphics.Primaries.Figure In doc.ModelSpace.Entities
            If figura Is Nothing OrElse figura.Deleted OrElse
               figura.Layer Is Nothing Then Continue For

            Dim parentDestino As Deswik.Graphics.Primaries.Layer = Nothing
            If destinoPorGuid.TryGetValue(figura.Layer.GUID, parentDestino) Then
                Try
                    figura.Layer = parentDestino
                    entidadesMovidas = entidadesMovidas + 1
                Catch exFigura As Exception
                    erroresEntidades = erroresEntidades + 1
                    If primerosErrores.Count &lt; 5 Then
                        primerosErrores.Add(figura.GUID &amp; ": " &amp; exFigura.Message)
                    End If
                End Try
            End If
        Next

        doc.ModelSpace.Entities.Update()

        Dim layersEliminadas As Integer = 0
        Dim layersConEntidades As Integer = 0
        Dim erroresLayers As Integer = 0

        For Each nombreChildEliminar As String In childNamesChildFirst
            Dim childEliminar As Deswik.Graphics.Primaries.Layer =
                doc.Layers.FindName(nombreChildEliminar, True)
            If childEliminar Is Nothing OrElse childEliminar.Deleted Then Continue For

            If childEliminar.NonDeletedEntitiesCount(doc) &gt; 0 Then
                layersConEntidades = layersConEntidades + 1
                Continue For
            End If

            If doc.Layers.Delete(childEliminar.Name) Then
                layersEliminadas = layersEliminadas + 1
            Else
                erroresLayers = erroresLayers + 1
            End If
        Next

        doc.ModelSpace.Entities.Update()
        doc.OnLayersRefresh()

        Dim resumen As New StringBuilder()
        resumen.AppendLine("Consolidacion terminada.")
        resumen.AppendLine()
        resumen.AppendLine("Parent layers procesadas: " &amp; parents.Count.ToString())
        resumen.AppendLine("Entidades movidas: " &amp; entidadesMovidas.ToString())
        resumen.AppendLine("Child layers eliminadas: " &amp; layersEliminadas.ToString())
        resumen.AppendLine("Child layers conservadas por contener entidades: " &amp;
                           layersConEntidades.ToString())
        resumen.AppendLine("Errores al mover entidades: " &amp; erroresEntidades.ToString())
        resumen.AppendLine("Errores al eliminar layers: " &amp; erroresLayers.ToString())

        If primerosErrores.Count &gt; 0 Then
            resumen.AppendLine()
            resumen.AppendLine("Primeros errores:")
            For Each detalleError As String In primerosErrores
                resumen.AppendLine("- " &amp; detalleError)
            Next
        End If

        Dim icono As MessageBoxIcon = MessageBoxIcon.Information
        If erroresEntidades &gt; 0 OrElse erroresLayers &gt; 0 OrElse
           layersConEntidades &gt; 0 Then icono = MessageBoxIcon.Warning

        MessageBox.Show(resumen.ToString(),
                        "Consolidar child layers",
                        MessageBoxButtons.OK,
                        icono)
    Catch ex As Exception
        MessageBox.Show("No se pudo completar la consolidacion: " &amp; ex.Message,
                        "Consolidar child layers",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Error)
    End Try
End Sub
