Imports System
Imports System.IO
Imports System.Text
Imports System.Collections.Generic
Imports System.Windows.Forms

Function EsLayerConsolidable(
        ByVal capa As Deswik.Graphics.Primaries.Layer) As Boolean
    If capa Is Nothing OrElse capa.Deleted Then Return False

    Dim nombre As String = capa.Name.Trim()
    If nombre.Length = 0 Then Return False

    Dim partes() As String = nombre.Split(New Char() {"\"c})
    Dim raiz As String = partes(0)

    If String.Equals(raiz,
                     "_DWG_HIDDEN_GRAPHICS",
                     StringComparison.OrdinalIgnoreCase) Then Return False
    If String.Equals(raiz,
                     "_DW_HIDDEN_GRAPHICS",
                     StringComparison.OrdinalIgnoreCase) Then Return False
    If String.Equals(raiz,
                     "DWG_SETTINGS",
                     StringComparison.OrdinalIgnoreCase) Then Return False
    If String.Equals(raiz,
                     "_DW_SETTINGS",
                     StringComparison.OrdinalIgnoreCase) Then Return False
    If raiz.StartsWith("_DWG_", StringComparison.OrdinalIgnoreCase) Then Return False
    If raiz.StartsWith("_DW_", StringComparison.OrdinalIgnoreCase) Then Return False

    Return True
End Function

Function TieneDescendientesConsolidados(
        ByVal capa As Deswik.Graphics.Primaries.Layer) As Boolean
    If capa Is Nothing OrElse capa.Deleted Then Return False

    For Each hija As Deswik.Graphics.Primaries.Layer In capa.ChildrenGetAsLayerList()
        If hija IsNot Nothing AndAlso Not hija.Deleted Then Return True
    Next
    Return False
End Function

Function EsNombreDescendiente(ByVal nombrePadre As String,
                              ByVal nombrePosibleHijo As String) As Boolean
    If String.IsNullOrEmpty(nombrePadre) OrElse
       String.IsNullOrEmpty(nombrePosibleHijo) Then Return False

    Return nombrePosibleHijo.StartsWith(
        nombrePadre &amp; "\",
        StringComparison.OrdinalIgnoreCase)
End Function

Function CrearHelperTemporalConsolidacionAura() As String
