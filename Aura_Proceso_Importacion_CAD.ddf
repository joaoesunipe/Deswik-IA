        Path.GetTempPath(), "aura_consolidacion_layers_" &amp; Guid.NewGuid().ToString("N") &amp; ".ps1")
    Dim auraMergeHelperBase64 As String = _
        "cGFyYW0oCiAgICBbUGFyYW1ldGVyKE1hbmRhdG9yeSA9ICR0cnVlKV1bc3RyaW5nXSRJbnB1dFBhdGgsCiAgICBbUGFyYW1ldGVyKE1hbmRhdG9yeSA9ICR0" &amp; _
